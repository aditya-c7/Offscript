# syntax=docker/dockerfile:1
# Offscript background worker (@offscript/worker) image for Cloudflare Containers.
# Build from the MONOREPO ROOT context:
#   docker build -f Dockerfile.worker .
FROM node:22-bookworm-slim

# Playwright's `--with-deps` and corepack need root during the build. The final
# runtime user is the non-root uid 10001; sandbox-disabling flags are never passed.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates fonts-liberation libnss3 \
 && corepack enable \
 && useradd --create-home --uid 10001 --shell /usr/sbin/nologin pwuser

# One shared browser cache for the root build user and the non-root runtime
# user; otherwise Playwright would look under /home/pwuser/.cache at runtime.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN install -d -m 0755 /ms-playwright

WORKDIR /app

# Manifests and workspace configuration first so dependency layers cache well.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json .npmrc ./
COPY apps ./apps
COPY packages ./packages

RUN pnpm install --frozen-lockfile \
 && pnpm --filter @offscript/worker build \
 && pnpm --filter @offscript/worker exec playwright install chromium --with-deps \
 && rm -rf /var/lib/apt/lists/* \
 && pnpm store prune

# Artifact directory must be writable by the non-root worker process.
RUN install -d -o 10001 -g 10001 -m 0755 /app/storage

ENV NODE_ENV=production \
    STORAGE_DIR=/app/storage

USER 10001:10001

CMD ["node", "apps/worker/dist/index.js"]
