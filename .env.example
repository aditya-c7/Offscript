# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# LLM Provider Selection: "openrouter" | "groq" | "gemini" | "openai"
LLM_PROVIDER="openrouter"

# API Keys (set whichever you use — never commit real keys)
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Role-based model routing
LLM_MODEL_FAST="openai/gpt-oss-20b:free"
LLM_MODEL_AGENT="openai/gpt-oss-120b:free"
LLM_MODEL_VISION="google/gemini-2.5-flash"

# Fallback provider if primary hits 429 rate limit
LLM_FALLBACK_PROVIDER="groq"
LLM_FALLBACK_MODEL_FAST="llama-3.3-70b-versatile"

# Storage
STORAGE_DIR="./storage"
