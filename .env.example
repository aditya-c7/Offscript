# Database driver
#   node       -> local Node worker uses a TCP connection pool (self-hosted compose / worker)
#   neon-http  -> Cloudflare Workers web uses Neon's HTTP driver (no TCP pool, no interactive transactions)
# Default: node. Use neon-http only for the Cloudflare Workers web deployment.
DB_DRIVER="node"

# Neon Postgres POOLED connection string - runtime / application queries only.
# Used by the app at runtime (including the neon-http driver on Cloudflare Workers).
# Placeholder - supply your own.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Neon Postgres UNPOOLED connection string - MIGRATIONS ONLY.
# Consumed exclusively by packages/db/drizzle.config.ts (drizzle-kit), never at
# runtime. Placeholder - supply your own.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"

# Public HTTPS URL of the Node worker enqueue endpoint, NOT localhost.
# The Workers web POSTs jobs and create/re-run commands here. Production must
# use a public HTTPS host (or a Cloudflare Tunnel/VPC hostname), never a
# loopback URL. http://localhost:8787/enqueue only works on a single machine
# and is for local development / CI only.
# Placeholder, supply your own public URL.
WORKER_ENQUEUE_URL="https://worker.example.com/enqueue"

# Shared secret the web sends to the Node worker on /enqueue (and the write
# routes). Keep in a secret store, never in the repository.
# Token name chosen as WORKER_ENQUEUE_TOKEN; confirm it matches the enqueue-auth
# agent's exact name/header before deploy. Placeholder, supply your own value.
WORKER_ENQUEUE_TOKEN=""

# Address the Node worker binds its enqueue HTTP listener to (local dev only).
# Defaults: 127.0.0.1 / 8787. In production bind behind TLS on a public host.
WORKER_ENQUEUE_HOST="127.0.0.1"
WORKER_ENQUEUE_PORT="8787"

# Public URL used by the web app.
NEXT_PUBLIC_SITE_URL="https://offscript.adityahq.me"
STORAGE_DIR="./storage"

# Primary LLM provider: nvidia | groq | openrouter
LLM_PROVIDER="openrouter"
LLM_FALLBACK_PROVIDER="groq"

# Role-based model defaults (valid on the OpenRouter free tier).
# Comma-separated fallbacks, if supported, are tried in order.
LLM_MODEL_FAST="nvidia/nemotron-3.5-lightning:free"
LLM_MODEL_AGENT="nvidia/nemotron-3.5-lightning:free"
LLM_MODEL_VISION="nvidia/nemotron-3.5-super-vl:free"
LLM_FALLBACK_MODEL_FAST="llama-3.3-70b-versatile"

# Provider API keys - leave empty here; supply values via your environment or secret store.
NVIDIA_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Cloudflare Workers web secrets (set with wrangler, never commit real values):
#   npx wrangler secret put DATABASE_URL
#   npx wrangler secret put OPENROUTER_API_KEY
#   npx wrangler secret put GROQ_API_KEY
#   npx wrangler secret put NVIDIA_API_KEY
#   npx wrangler secret put WORKER_ENQUEUE_URL
#   npx wrangler secret put WORKER_ENQUEUE_TOKEN
