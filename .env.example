# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Primary LLM provider (NVIDIA NIM by default)
LLM_PROVIDER="nvidia"
NVIDIA_API_KEY=""

# Optional secondary providers. Set a key to enable automatic fallback.
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""

# Role-based model routing. Comma-separated lists try the next model on
# 429/503/timeout; a failed model is kept on a 60s cooldown.
# Fast: website interpretation and fix summaries
LLM_MODEL_FAST="meta/llama-3.3-70b-instruct,openai/gpt-oss-20b"
# Agent: page-structure loop (Check 1)
LLM_MODEL_AGENT="openai/gpt-oss-120b,qwen/qwen3-235b-a22b"
# Vision: screenshot checks and verifier (Check 2)
LLM_MODEL_VISION="meta/llama-3.2-90b-vision-instruct,mistralai/mistral-large-3-675b-instruct-2512"

# Provider used after every model of the primary provider is exhausted
LLM_FALLBACK_PROVIDER="groq"
LLM_FALLBACK_MODEL_FAST="llama-3.3-70b-versatile"

# Storage
STORAGE_DIR="./storage"
